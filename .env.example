# Client (Vite): foglio Google
VITE_GOOGLE_SHEETS_WEBAPP_URL=

# Server (Vercel → Environment Variables, senza prefisso VITE_)
# Mittente verificato su Resend, es. "AMG Sistemi <notifiche@tuodominio.it>"
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Opzionale: con `vercel dev` (es. :3000) e `npm run dev` (es. :8080) per provare l’API email
# VITE_LEAD_API_ORIGIN=http://localhost:3000

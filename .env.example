# Client (Vite): URL /exec dello script Google (opzionale se usi GOOGLE_SHEETS_WEBAPP_URL + VITE_LEADS_SHEET su Vercel)
VITE_GOOGLE_SHEETS_WEBAPP_URL=
# Su Vercel: "true" se l’URL dello script è solo lato server (GOOGLE_SHEETS_WEBAPP_URL)
# VITE_LEADS_SHEET=true

# Server (Vercel): stesso URL /exec — usato da /api/submit-lead-sheet (salvataggio affidabile)
# GOOGLE_SHEETS_WEBAPP_URL=

# Server (Vercel): Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="AMG Sistemi <info@richiestainfo.com>"

# Opzionale: `vercel dev` su altra porta rispetto a Vite
# VITE_LEAD_API_ORIGIN=http://localhost:3000
